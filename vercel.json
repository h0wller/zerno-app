{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run test:unit && npm run build:client",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
