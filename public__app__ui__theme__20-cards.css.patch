diff --git a/public/app/ui/theme/20-cards.css b/public/app/ui/theme/20-cards.css
index fa262d0..ae9b0d1 100644
--- a/public/app/ui/theme/20-cards.css
+++ b/public/app/ui/theme/20-cards.css
@@ -134,2 +134,12 @@ body.editing .card:hover{
   color: var(--soft);
+  /* Описание разной длины не должно разносить высоту карточек: режем на 2 строки
+     и держим постоянный резерв высоты (иначе в ряду часть карточек выше).
+     line-height и min-height заданы явно: резерв в em плавал бы вместе с метриками
+     шрифта (до загрузки Golos Text и после) и давал высоты 35/38px вперемешку. */
+  line-height: 1.45;
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+  min-height: 37px;
 }
@@ -137,5 +147,9 @@ body.editing .card:hover{
   display: flex;
-  flex-wrap: wrap;
+  flex-wrap: nowrap;
   gap: 5px;
   margin-top: 2px;
+  /* Состав разной длины не должен менять высоту карточки: чипсы в одну строку,
+     лишнее обрезается по правому краю. С flex-wrap: wrap карточка с тремя длинными
+     чипсами вырастала на строку (+4px) и ломала одинаковую высоту рядов. */
+  overflow: hidden;
 }
@@ -149,2 +163,3 @@ body.editing .card:hover{
   color: #123A6B;
+  flex: 0 0 auto;
 }
@@ -154,3 +169,5 @@ body.editing .card:hover{
   letter-spacing: 0.04em;
-  margin-top: auto;
+  /* К низу карточки прижимает .cfoot (margin-top: auto). Если оставить auto и здесь,
+     свободное место делится пополам и объём «повисает» в середине карточки. */
+  margin-top: 2px;
 }
@@ -160,3 +177,6 @@ body.editing .card:hover{
   justify-content: space-between;
-  margin-top: 6px;
+  /* auto + flex:1 у .cbody: цена/кнопка всегда прижаты к низу карточки,
+     даже если описание короткое или .vol отсутствует. */
+  margin-top: auto;
+  padding-top: 6px;
 }
@@ -181,7 +201,9 @@ body.editing .card:hover{
 .card .steprow [data-step]:not([hidden]) {
-  width: 40px;
-  height: 40px;
-  min-width: 40px;
-  min-height: 40px;
-  flex: 0 0 40px;
+  /* 44×44px — минимум тач-таргета (было 40×40: формально проходило тест с порогом 40,
+     но не дотягивало до цели аудита карточек). */
+  width: 44px;
+  height: 44px;
+  min-width: 44px;
+  min-height: 44px;
+  flex: 0 0 44px;
   border-radius: var(--radius-sm, 10px);
