{
  "name": "zerno-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "smoke": "node scripts/contract-smoke.mjs",
    "test": "node test-api.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "pretest": "node --check public/app/core/views.js && node --check public/dist/main.bundle.js && node scripts/css-audit.mjs && node scripts/brands-check.mjs && node scripts/audit-observers.mjs && npm run test:unit",
    "test:e2e": "npm run build:client && playwright test",
    "ui:baseline": "npx playwright test tests/ui-baseline.spec.js --update-snapshots",
    "check": "node --check server.js",
    "lint:code": "eslint public/ server/ scripts/ --max-warnings 50",
    "lint:dup": "jscpd --config .jscpd.json public/ && jscpd --config .jscpd.strict.json server/ public/app/",
    "lint:dead": "knip",
    "lint:layers": "depcruise --config .dependency-cruiser.js public server",
    "lint:observers": "node scripts/audit-observers.mjs",
    "bump:sw": "node scripts/bump-sw.mjs",
    "audit": "npm run check && npm run pretest && npm run lint:code && npm run lint:dup && npm run lint:dead && npm run lint:layers && npm run smoke && npm run test:e2e",
    "build:client": "npm run bump:sw && esbuild public/app/main.js --bundle --minify --sourcemap --format=esm --target=es2022 --outfile=public/dist/main.bundle.js",
    "test:unit": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "firebase-admin": "^14.3.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "dependency-cruiser": "^18.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "knip": "^6.44.1"
  },
  "overrides": {
    "@google-cloud/firestore": "9.4.0",
    "@google-cloud/firestore-api": "0.7.1",
    "@eslint/config-array": {
      "minimatch": "^11.0.3"
    },
    "eslint-plugin-sonarjs": {
      "minimatch": "^11.0.3"
    },
    "rimraf@^6.0.1": {
      "glob": "^14.0.2"
    },
    "braces": "^3.0.3",
    "micromatch": "^4.0.8"
  }
}
