+  "sourcesContent": ["/* public/app/core/bus.js \u2014 F5.72: \u041B\u0435\u0433\u043A\u043E\u0432\u0435\u0441\u043D\u044B\u0439 EventBus \u0434\u043B\u044F \u043C\u0435\u0436\u043C\u043E\u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u0441\u0432\u044F\u0437\u0438 */\nconst target = new EventTarget();\n\nexport function emit(event, detail = null) {\n  target.dispatchEvent(new CustomEvent(event, { detail }));\n}\n\nexport function on(event, callback) {\n  const handler = (e) => callback(e.detail);\n  target.addEventListener(event, handler);\n  // \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0444\u0443\u043D\u043A\u0446\u0438\u044E \u043E\u0442\u043F\u0438\u0441\u043A\u0438\n  return () => target.removeEventListener(event, handler);\n}\n\nexport function once(event, callback) {\n  const handler = (e) => callback(e.detail);\n  target.addEventListener(event, handler, { once: true });\n}\n\n// \u0414\u043E\u0441\u0442\u0443\u043F \u0432 \u0433\u043B\u043E\u0431\u0430\u043B\u044C\u043D\u0443\u044E \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u0434\u043B\u044F \u043F\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 vanilla-\u0441\u043A\u0440\u0438\u043F\u0442\u043E\u0432\nif (typeof window !== 'undefined') {\n  window.ztBus = { emit, on, once };\n}", "/* public/app/brands/registry.js \u2014 \u043C\u0430\u043D\u0438\u0444\u0435\u0441\u0442 \u0431\u0440\u0435\u043D\u0434\u043E\u0432 (\u0434\u0430\u043D\u043D\u044B\u0435, \u043D\u0435 \u043A\u043E\u0434).\n   \u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0431\u0440\u0435\u043D\u0434\u043E\u0432\u043E\u0433\u043E \u043A\u043E\u043D\u0442\u0435\u043D\u0442\u0430: \u043B\u043E\u0433\u043E\u0442\u0438\u043F, \u0442\u0438\u043A\u0435\u0440, \u0447\u0430\u0442, \u0441\u043F\u043B\u044D\u0448.\n   \u0412\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0435 \u0442\u043E\u043A\u0435\u043D\u044B (\u0446