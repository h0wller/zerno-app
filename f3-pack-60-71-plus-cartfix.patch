      const r = await (\n        await fetch(\n          API_BASE +\n            \"/api/chat/thread?key=\" +\n            encodeURIComponent(chatKey()) +\n            \"&after=0\",\n        )\n      ).json();\n      $(\"#chatMsgs\").innerHTML = \"\";\n      staffIn = false;\n      for (const m of r.msgs) {\n        lastChatId = Math.max(lastChatId, m.id);\n        if (m.who === \"guest\") addMsg(\"me\", m.text);\n        else if (m.who === \"staff\") addMsg(\"staff\", m.text);\n        else if (m.who === \"system\") {\n          staffIn = m.text.includes(\"\u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u043B\u0441\u044F\");\n          addMsg(\"sys\", m.text);\n        } else addMsg(\"bot\", m.text);\n      }\n      $(\"#chatFab\").classList.toggle(\"live\", staffIn);\n      historyLoaded = true;\n    } catch (e) {\n      historyLoaded = true;\n    }\n  }\n  /* \u2500\u2500 \u0441\u0442\u0430\u0444\u0444: \u0447\u0430\u0442\u044B \u0433\u043E\u0441\u0442\u0435\u0439 \u2500\u2500 */\nfunction openStaffChat(forceCtx) {\n  window.__staffChatFilter = (typeof forceCtx === 'string' && (forceCtx === 'delivery' || forceCtx === 'coffee'))\n    ? forceCtx\n    : (typeof mode !== 'undefined' && mode === 'orders' ? 'delivery' : (typeof mode !== 'undefined' && mode === 'cashier' ? 'coffee' : null));\n  if (me && 'Notification' in window) {\n    if (Notification.permission !== 'granted')\n      toast('\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F \u0432 \u043F\u0440\u043E\u0444\u0438\u043B\u0435 \u2014 \u0438\u043D\u0430\u0447\u0435 \u043D\u0435 \u0443\u0437\u043D\u0430\u0435\u0442\u0435 \u043E \u0432\u043E\u043F\u0440\u043E\u0441\u0430\u0445 \u0433\u043E\u0441\u0442\u0435\u0439', '\uD83D\uDD14');\n    else\n      navigator.serviceWorker.ready\n        .then(r => r.pushManager.getSubscription())\n        .then(s => {\n          if (!s) toast('\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0443\u0432\u0435\