('drop', function (e) {\n    if (!opts.canDrag() || !dragId) return;\n    e.preventDefault();\n    const dst = e.target.closest ? e.target.closest('.card:not(.dragging)') : null;\n    const fromId = dragId;\n    dragId = null;\n    cleanMarks(gridEl);\n    if (!dst) return;\n    const toId = cardId(dst);\n    if (!toId || toId === fromId) return;\n    const ids = opts.getIds().slice();\n    const from = ids.indexOf(fromId);\n    const to = ids.indexOf(toId);\n    if (from < 0 || to < 0 || from === to) return;\n    ids.splice(from, 1);\n    ids.splice(to, 0, fromId);\n    opts.onReorder(ids).catch(function (err) {\n      if (typeof window.toast === 'function') window.toast(err.message || '\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u043F\u043E\u0440\u044F\u0434\u043E\u043A', '\u26A0\uFE0F');\n      opts.rerender();\n    });\n  });\n\n  gridEl.addEventListener('dragend', function () {\n    dragId = null;\n    cleanMarks(gridEl);\n  });\n}", "/* public/app/menu.js \u2014 F2.6a: \u0433\u043E\u0441\u0442\u0435\u0432\u043E\u0435 \u043C\u0435\u043D\u044E \u2014 \u0440\u0435\u0439\u043B, \u043F\u043E\u0438\u0441\u043A, \u0441\u0435\u0442\u043A\u0430, \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440-\u0437\u0443\u043C.\n   \u0411\u0435\u0437 IIFE: fix-views.js \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442 window.renderMenu(499) \u0438 window.renderRail(502),\n   \u0447\u0438\u0442\u0430\u0435\u0442 CATS \u043B\u0435\u043A\u0441\u0438\u0447\u0435\u0441\u043A\u0438 (406). \u0412\u0441\u0435 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u044F \u2014 top-level var/function. */\nimport { attachGridDnD, canDragMenu, dragAttr } from './core/dnd.js';\nwindow.cat = 'coffee'; /* \u04245.6-\u0444\u0438\u043D\u0430\u043B \u0448\u0430\u0433 4-fix: menu-editor \u0447\u0438\u0442\u0430\u0435\u0442 cat \u0433\u043E\u043B\u044B\u043C */\nwindow.query = ''; /* \u04245.6-\u0444\u0438\u043D\u0430\u